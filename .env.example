# LLM for the idea command (copy to .env and fill in). Same gateway as the content suggester.
LLM_BASE_URL=https://api.unoblox.ai/v1
UNOBLOX_API_KEY=
# Cheap tier: short, structured posts (feature launches, LinkedIn images)
LLM_MODEL_FAST=anthropic/claude-haiku-5-5
LLM_PRICE_FAST_INPUT_PER_MTOK=
LLM_PRICE_FAST_OUTPUT_PER_MTOK=
# Storytelling tier: explainers, talking heads, generic videos
LLM_MODEL_SMART=anthropic/claude-sonnet-5-5
LLM_PRICE_SMART_INPUT_PER_MTOK=
LLM_PRICE_SMART_OUTPUT_PER_MTOK=
# Optional: only if Remotion can't download its own browser
# VISUALS_CHROME=
# Web app login. Required before opening the app beyond this Mac (tunnel / --host 0.0.0.0).
# WEBAPP_USER=admin
# WEBAPP_PASSWORD=
